{
  "publisher": "abhijeetkaze",
  "name": "amaze-browser",
  "displayName": "Amaze Browser",
  "version": "1.4.1",
  "packageManager": "pnpm@8.9.2",
  "description": "A fast embedded Chromium browser inside VS Code, with DevTools, device emulation and live preview.",
  "author": {
    "name": "Abhijeet Mohanta",
    "url": "https://abhijeetmohanta.in"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/abhijeetkaze/amaze-browser.git"
  },
  "sponsor": {
    "url": "https://www.buymeacoffee.com/abhijeetkaze"
  },
  "categories": [
    "Other",
    "Debuggers"
  ],
  "keywords": [
    "browser",
    "preview",
    "live preview",
    "chromium",
    "devtools",
    "web",
    "embedded browser"
  ],
  "main": "./dist/extension.js",
  "icon": "resources/icon.png",
  "engines": {
    "vscode": "^1.83.0"
  },
  "activationEvents": [
    "onOpenExternalUri:http",
    "onOpenExternalUri:https",
    "onDebugInitialConfigurations",
    "onDebug",
    "onFileSystem:vsls"
  ],
  "contributes": {
    "commands": [
      {
        "category": "Amaze Browser",
        "command": "amaze-browser.open",
        "title": "Open..."
      },
      {
        "category": "Amaze Browser",
        "command": "amaze-browser.newTab",
        "title": "New Tab"
      },
      {
        "category": "Amaze Browser",
        "command": "amaze-browser.showHistory",
        "title": "Show History"
      },
      {
        "category": "Amaze Browser",
        "command": "amaze-browser.startServer",
        "title": "Start HTTP Server (Open in Your Browser)"
      },
      {
        "category": "Amaze Browser",
        "command": "amaze-browser.stopServer",
        "title": "Stop HTTP Server"
      },
      {
        "category": "Amaze Browser",
        "command": "amaze-browser.moveDevTools",
        "title": "Move DevTools...",
        "icon": "$(layout)"
      },
      {
        "category": "Amaze Browser",
        "command": "amaze-browser.clearBrowsingData",
        "title": "Clear History and Cookies"
      },
      {
        "category": "Amaze Browser",
        "command": "amaze-browser.showSupportPrompt",
        "title": "Show Support Notification"
      },
      {
        "category": "Amaze Browser",
        "command": "amaze-browser.openActiveFile",
        "title": "Open Active File in Preview"
      },
      {
        "category": "Amaze Browser",
        "command": "amaze-browser.controls.refresh",
        "title": "Refresh Page",
        "icon": "$(refresh)"
      },
      {
        "category": "Amaze Browser",
        "command": "amaze-browser.controls.external",
        "title": "Open page with system browser",
        "icon": "$(link-external)"
      },
      {
        "category": "Amaze Browser",
        "command": "amaze-browser.controls.debug",
        "title": "Open debug page",
        "icon": "$(bug)"
      },
      {
        "category": "Amaze Browser",
        "command": "amaze-browser.openServerInBrowser",
        "title": "Open HTTP Server in Your Browser"
      }
    ],
    "configuration": {
      "title": "Amaze Browser",
      "type": "object",
      "properties": {
        "amaze-browser.startUrl": {
          "description": "The default start url for new Amaze Browser instances",
          "type": "string"
        },
        "amaze-browser.chromeExecutable": {
          "description": "The full path to the executable, including the complete filename of the executable. When empty on Linux, Amaze Browser downloads and uses its own Chromium build.",
          "type": "string"
        },
        "amaze-browser.downloadPath": {
          "default": "",
          "description": "Folder where downloaded files are saved. Leave empty to use ~/Downloads.",
          "type": "string"
        },
        "amaze-browser.devToolsPosition": {
          "default": "right",
          "enum": [
            "right",
            "bottom",
            "left",
            "window"
          ],
          "enumDescriptions": [
            "Next to the page",
            "Below the page",
            "Before the page",
            "In a separate VS Code window"
          ],
          "description": "Where DevTools opens. Change it any time with the Move DevTools button in the DevTools tab.",
          "type": "string"
        },
        "amaze-browser.showSupportPrompt": {
          "default": true,
          "description": "Occasionally ask whether you'd like to support Amaze Browser (at most twice, only after regular use).",
          "type": "boolean"
        },
        "amaze-browser.verbose": {
          "default": false,
          "description": "Toggles verbose logging",
          "type": "boolean"
        },
        "amaze-browser.debugHost": {
          "default": "localhost",
          "description": "Host name for debug",
          "type": "string"
        },
        "amaze-browser.debugPort": {
          "default": 9222,
          "description": "Port number for debug, when occupied, it will try to find another one by self bumpping.",
          "type": "number"
        },
        "amaze-browser.format": {
          "default": "jpeg",
          "enum": [
            "png",
            "jpeg"
          ],
          "description": "The type of image used in rendering preview.",
          "type": "string"
        },
        "amaze-browser.ignoreHttpsErrors": {
          "default": true,
          "description": "Ignore HTTPS errors if you are using self-signed SSL certificates",
          "type": "boolean"
        },
        "amaze-browser.quality": {
          "default": 80,
          "description": "Image quality of screencasting",
          "type": "number"
        },
        "amaze-browser.everyNthFrame": {
          "default": 1,
          "description": "Skip for frames of screencasting",
          "type": "number"
        },
        "amaze-browser.localFileAutoReload": {
          "default": true,
          "description": "Automatically reload page on local file changes",
          "type": "boolean"
        },
        "amaze-browser.storeUserData": {
          "default": true,
          "description": "Store cookies, localStorage, etc. on disk, so that you don't lose them when you close session. This will help you not get logged out.",
          "type": "boolean"
        },
        "amaze-browser.proxy": {
          "description": "Add proxy parameters during initial loading of the browser.",
          "type": "string"
        },
        "amaze-browser.otherArgs": {
          "description": "Add other parameters during initial loading of the browser.",
          "type": "string"
        },
        "amaze-browser.server.port": {
          "default": 8100,
          "description": "Port of the HTTP server started by \"Amaze Browser: Start HTTP Server\", which lets you use Amaze Browser from your own browser at http://localhost:<port>. It only accepts connections from this machine.",
          "type": "number"
        }
      }
    },
    "debuggers": [
      {
        "type": "amaze-browser",
        "label": "Amaze Browser",
        "configurationSnippets": [
          {
            "label": "Amaze Browser: Launch",
            "description": "Launch Amaze Browser to localhost",
            "body": {
              "type": "amaze-browser",
              "request": "launch",
              "name": "Amaze Browser: Launch",
              "url": "http://localhost:3000"
            }
          },
          {
            "label": "Amaze Browser: Attach",
            "description": "Attach to open Amaze Browser instances",
            "body": {
              "type": "amaze-browser",
              "request": "attach",
              "name": "Amaze Browser: Attach"
            }
          }
        ],
        "configurationAttributes": {
          "launch": {
            "properties": {
              "url": {
                "type": "string",
                "description": "Absolute url to launch",
                "default": "http://localhost:3000"
              },
              "webRoot": {
                "type": "string",
                "description": "This specifies the workspace absolute path to the webserver root. Used to resolve paths like `/app.js` to files on disk. Shorthand for a pathMapping for \"/\"",
                "default": "${workspaceFolder}"
              },
              "pathMapping": {
                "type": "object",
                "description": "A mapping of URLs/paths to local folders, to resolve scripts in Chrome to scripts on disk",
                "default": {
                  "/": "${workspaceFolder}"
                }
              },
              "trace": {
                "type": [
                  "boolean",
                  "string"
                ],
                "enum": [
                  "verbose",
                  true
                ],
                "default": true,
                "description": "When 'true', the debugger will log tracing info to a file. When 'verbose', it will also show logs in the console."
              },
              "sourceMapPathOverrides": {
                "type": "object",
                "description": "A set of mappings for rewriting the locations of source files from what the sourcemap says, to their locations on disk. See README for details.",
                "default": {
                  "webpack:///./*": "${webRoot}/*",
                  "webpack:///src/*": "${webRoot}/*",
                  "webpack:///*": "*",
                  "webpack:///./~/*": "${webRoot}/node_modules/*",
                  "meteor://💻app/*": "${webRoot}/*"
                }
              }
            }
          },
          "attach": {
            "properties": {
              "urlFilter": {
                "type": "string",
                "description": "Will search for a page with this url and attach to it, if found. Can have * wildcards.",
                "default": ""
              },
              "webRoot": {
                "type": "string",
                "description": "This specifies the workspace absolute path to the webserver root. Used to resolve paths like `/app.js` to files on disk. Shorthand for a pathMapping for \"/\"",
                "default": "${workspaceFolder}"
              },
              "pathMapping": {
                "type": "object",
                "description": "A mapping of URLs/paths to local folders, to resolve scripts in Chrome to scripts on disk",
                "default": {
                  "/": "${workspaceFolder}"
                }
              },
              "trace": {
                "type": [
                  "boolean",
                  "string"
                ],
                "enum": [
                  "verbose",
                  true
                ],
                "default": true,
                "description": "When 'true', the debugger will log tracing info to a file. When 'verbose', it will also show logs in the console."
              },
              "sourceMapPathOverrides": {
                "type": "object",
                "description": "A set of mappings for rewriting the locations of source files from what the sourcemap says, to their locations on disk. See README for details.",
                "default": {
                  "webpack:///./*": "${webRoot}/*",
                  "webpack:///src/*": "${webRoot}/*",
                  "webpack:///*": "*",
                  "webpack:///./~/*": "${webRoot}/node_modules/*",
                  "meteor://💻app/*": "${webRoot}/*"
                }
              }
            }
          }
        }
      }
    ],
    "menus": {
      "editor/title": [
        {
          "when": "resourceScheme == webview-panel && amaze-browser-active",
          "command": "amaze-browser.controls.external",
          "group": "navigation"
        },
        {
          "when": "resourceScheme == webview-panel && amaze-browser-active && !amaze-browser-debug-active",
          "command": "amaze-browser.controls.debug",
          "group": "navigation"
        },
        {
          "when": "resourceScheme == webview-panel && amaze-browser-debug-active",
          "command": "amaze-browser.moveDevTools",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "amaze-browser.controls.refresh",
          "when": "false"
        },
        {
          "command": "amaze-browser.controls.external",
          "when": "false"
        },
        {
          "command": "amaze-browser.controls.debug",
          "when": "false"
        },
        {
          "command": "amaze-browser.openServerInBrowser",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "build:dev": "vite build && npm run build:ts",
    "publish": "ovsx publish --no-dependencies",
    "pack": "node -e \"require('fs').mkdirSync('bin',{recursive:true})\" && vsce package --no-dependencies -o bin",
    "build": "rimraf dist && vite build && pnpm run build:ts --minify",
    "build:ts": "tsup src/extension.ts --external=vscode -d dist",
    "lint": "eslint .",
    "release": "bumpp"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^1.0.0-beta.27",
    "@chiragrupani/karma-chromium-edge-launcher": "^2.3.1",
    "@puppeteer/browsers": "^1.9.1",
    "@types/karma-chrome-launcher": "^3.1.2",
    "@types/lodash": "^4.14.199",
    "@types/node": "20.8.6",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.13",
    "@types/vscode": "1.83.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react-refresh": "^1.3.6",
    "@vscode/vsce": "^2.21.1",
    "browser-viewport-device-descriptions": "^1.1.0",
    "bumpp": "^9.2.0",
    "conventional-github-releaser": "^3.1.5",
    "element-to-source": "^1.0.1",
    "eslint": "^8.51.0",
    "event-emitter-enhancer": "^2.0.0",
    "eventemitter2": "^6.4.9",
    "find-up": "^6.3.0",
    "karma-chrome-launcher": "^3.2.0",
    "lodash": "^4.17.21",
    "ovsx": "^0.8.3",
    "puppeteer-core": "^21.3.8",
    "re-resizable": "^6.9.11",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "rimraf": "^5.0.5",
    "tsup": "^7.2.0",
    "typescript": "^5.2.2",
    "vite": "^4.4.11",
    "ws": "^8.22.0"
  },
  "extensionKind": [
    "ui",
    "workspace"
  ]
}
